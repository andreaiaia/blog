---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import TitleSection from '@/components/TitleSection/TitleSection.astro';
import css from '@/styles/Photo.module.scss';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import { categoryLabels } from '@/i18n/categories';
import CFImage from '@/components/CFImage/CFImage.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const albums = (await getCollection('albums'))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const IMAGE_SIZES = '(min-width: 1200px) 544px, 100vw';
---

<BaseLayout
  title={t('nav.photo')}
  descrition='My photography: capturing the essence of a moment'
  headerMode='solid'
  lang={lang}
>
  <main class={css.page}>
    <TitleSection title={t('photo.pageTitle')} />
    <div class={css.columns}>
      {
        albums.map(({ id, data }) => (
          <a class={css.entry} href={`/en/photo/${id}`}>
            <div class={css.entryFrame}>
              <CFImage
                src={data.cover}
                alt={data.coverAlt}
                widths={[600, 900, 1200]}
                sizes={IMAGE_SIZES}
              />
            </div>
            <div class={css.entryCaption}>
              <h2 class={css.entryTitle}>{data.title}</h2>
              <span class={css.entryCategory}>
                {categoryLabels[lang][data.category]} • {data.location}
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </main>
</BaseLayout>
