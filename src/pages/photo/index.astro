---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import css from '@/styles/Photo.module.scss';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import CFImage from '@/components/CFImage/CFImage.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const albums = (await getCollection('albums'))
  .filter(({ data }) => data.published)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const entries = albums.map((album, i) => ({ album, i }));
const leftEntries = entries.filter(({ i }) => i % 2 === 1);
const rightEntries = entries.filter(({ i }) => i % 2 === 0);

const IMAGE_SIZES = '(min-width: 1200px) 544px, 100vw';
---

<BaseLayout
  title={t('nav.photo')}
  descrition="La mia fotografia: cercare l'essenza di un istante"
  headerMode='solid'
  lang={lang}
>
  <main class={css.page}>
    <div class={css.columns}>
      <div class={css.col}>
        <div class={css.pageHead} style='order:0'>
          <h1>{t('photo.pageTitle')}</h1>
        </div>
        {
          leftEntries.map(({ album: { id, data }, i }) => (
            <a class={css.entry} href={`/photo/${id}`} style={`order:${i + 1}`}>
              <div class={css.entryFrame}>
                <CFImage
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[600, 900, 1200]}
                  sizes={IMAGE_SIZES}
                />
              </div>
              <div class={css.entryCaption}>
                <h2 class={css.entryTitle}>{data.title}</h2>
                {data.category && (
                  <span class={css.entryCategory}>{data.category}</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
      <div class={css.col}>
        {
          rightEntries.map(({ album: { id, data }, i }) => (
            <a class={css.entry} href={`/photo/${id}`} style={`order:${i + 1}`}>
              <div class={css.entryFrame}>
                <CFImage
                  src={data.cover}
                  alt={data.coverAlt}
                  widths={[600, 900, 1200]}
                  sizes={IMAGE_SIZES}
                />
              </div>
              <div class={css.entryCaption}>
                <h2 class={css.entryTitle}>{data.title}</h2>
                {data.category && (
                  <span class={css.entryCategory}>{data.category}</span>
                )}
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </main>
</BaseLayout>
