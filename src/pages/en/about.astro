---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';
import CFImage from '@/components/CFImage/CFImage.astro';
import css from '@/styles/About.module.scss';
import { SocialLinks } from '@/utils/constants';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<script
  is:inline
  src='https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?version=4.8.0&features=IntersectionObserver'
  integrity='sha384-ac2tY+FDuY06qMD2drYkVmGsfdnlZ+PYRyrM1HEheFY7T+o8lxfTJ7NnRuyX0l7H'
  crossorigin='anonymous'></script>

<BaseLayout
  title={t('site.title')}
  description={t('site.description')}
  headerMode='solid'
  lang={lang}
>
  <main class={css.page}>
    <div class={css.header} data-aos>
      <p class={css.sectionTag}>About me</p>
      <h1 class={css.headline}>
        Andrea Bianchi —<br /><em>documentary photographer</em>
      </h1>
      <p class={css.headerSubtitle}>Out with a camera since 2012.</p>
    </div>

    <section class={css.bioSection}>
      <div class={css.bioGrid}>
        <div data-aos>
          <div class={css.bioText}>
            <p>
              I photograph the world starting from where I grew up: Matera. From
              the first moment I picked up a camera, I knew it was my instrument;
              there was something about expressing myself through images that felt
              immediately and completely natural.
            </p>
            <p>
              My work is an attempt to tell the stories that strike me, to
              document their quiet strength and extraordinary character, searching
              everywhere for that same gentleness and resilience I first learned
              to recognize at home.
            </p>
            <p>
              I photograph whatever catches my attention: landscapes, animals,
              people, fleeting moments. Composition is something I think about
              deeply: I feel a natural pull toward symmetry and balance, even if
              I know when to let them go.
            </p>
          </div>
          <div class={css.originPhotoWrap}>
            <CFImage
              className={css.originPhoto}
              src='misc/la-mia-prima-foto.jpg'
              alt='The first photo, a long exposure of moving cars in Matera.'
              widths={[480, 800]}
              sizes='(max-width: 850px) 100vw, 55vw'
            />
            <p class={css.originCaption}>
              The photo that started it all, 2012.
            </p>
          </div>
        </div>
        <div class={css.bioPhotoWrap} data-aos>
          <CFImage
            className={css.bioPhoto}
            src='me/profile-pic.jpg'
            alt='A photograph of me, Andrea.'
            widths={[480, 800]}
            sizes='(max-width: 850px) 100vw, 45vw'
          />
        </div>
      </div>
    </section>

    <section class={css.socialSection} data-aos>
      <p class={css.socialLabel}>Find me on</p>
      <div class={css.socialLinks}>
        <a
          class={css.socialLink}
          href={SocialLinks.instagram}
          target='_blank'
          rel='noopener noreferrer'>Instagram</a
        >
        <a
          class={css.socialLink}
          href={SocialLinks.youtube}
          target='_blank'
          rel='noopener noreferrer'>YouTube</a
        >
        <a
          class={css.socialLink}
          href={SocialLinks.github}
          target='_blank'
          rel='noopener noreferrer'>GitHub</a
        >
      </div>
    </section>
  </main>

  <script is:inline>
    (function () {
      function setup() {
        var elements = document.querySelectorAll('[data-aos]');
        var observer = new IntersectionObserver(
          function (entries, obs) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('animate');
                obs.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.07 }
        );
        elements.forEach(function (el) {
          observer.observe(el);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setup);
      } else {
        setup();
      }
    })();
  </script>
</BaseLayout>
